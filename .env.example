# ── required ──
POSTGRES_PASSWORD=change-me-long-random
SECRET_KEY=change-me-64-random-chars            # signs session cookies
PUBLIC_URL=https://sports.example.go.ke         # used in emails, QR codes, M-Pesa callback
BOOTSTRAP_ADMIN_EMAIL=admin@example.go.ke       # first Super Administrator (asked to change password on first sign-in)
BOOTSTRAP_ADMIN_PASSWORD=change-me-12-chars-min
BOOTSTRAP_ADMIN_NAME=Super Administrator
SEED_DEMO=0                                     # 1 only for a demo/staging server
WEB_PORT=8090

# ── M-Pesa (Daraja). Start on the sandbox, switch MPESA_ENV=production later ──
PAYMENT_PROVIDER=mpesa
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=                                  # from the Daraja portal "Test credentials"
MPESA_CALLBACK_SECRET=change-me-random          # becomes part of the callback URL

# ── email (optional; without it, notifications appear in-app only) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.go.ke

# ── policy ──
REQUIRE_STAFF_2FA=0
CERT_VALID_DAYS=365
